{
  "name": "subtitle-app",
  "productName": "Subtitle Generator",
  "version": "1.0.2",
  "description": "Create .srt subtitles for videos with faster-whisper",
  "author": "Zepphania",
  "license": "Apache-2.0",
  "repository": "github:zepph7/subtitle-generator",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "pack": "electron-builder --win --dir"
  },
  "build": {
    "appId": "com.zepphania.subtitlegenerator",
    "productName": "Subtitle Generator",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "engine.py",
      "build/icon.png",
      "LICENSE",
      "NOTICE"
    ],
    "asarUnpack": [
      "engine.py"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "license": "build/license.txt",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Subtitle-Generator-Setup.exe",
      "shortcutName": "Subtitle Generator"
    },
    "toolsets": {
      "nsis": "1.2.1"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.18.0"
  }
}
