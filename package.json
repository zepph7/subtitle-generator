{
  "name": "subtitle-app",
  "productName": "Subtitle Generator",
  "version": "1.0.3",
  "description": "Create .srt subtitles for videos with faster-whisper",
  "author": "Zepphania",
  "license": "Apache-2.0",
  "repository": "github:zepph7/subtitle-generator",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "dist": "electron-builder --win",
    "pack": "electron-builder --win --dir",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.zepphania.subtitlegenerator",
    "productName": "Subtitle Generator",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "engine.py",
      "build/icon.png",
      "LICENSE",
      "NOTICE"
    ],
    "asarUnpack": [
      "engine.py"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "license": "build/license.txt",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Subtitle-Generator-Setup.exe",
      "shortcutName": "Subtitle Generator"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "synopsis": "Create .srt subtitles for videos with faster-whisper",
      "maintainer": "Zepphania <zepph7@users.noreply.github.com>"
    },
    "appImage": {
      "artifactName": "Subtitle-Generator-${arch}.AppImage"
    },
    "deb": {
      "artifactName": "Subtitle-Generator-${arch}.deb",
      "recommends": [
        "python3",
        "python3-venv"
      ],
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.video",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "artifactName": "Subtitle-Generator-mac-${arch}.dmg"
    },
    "toolsets": {
      "nsis": "1.2.1"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.18.0"
  }
}
